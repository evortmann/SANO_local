{
  "name": "NutritionalGuidance",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "ID do paciente"
    },
    "nome_paciente": {
      "type": "string",
      "description": "Nome do paciente"
    },
    "medicamentos_analisados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de medicamentos analisados"
    },
    "interacoes_identificadas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "medicamento": {
            "type": "string"
          },
          "nutriente": {
            "type": "string"
          },
          "severidade": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          }
        }
      },
      "description": "Intera\u00e7\u00f5es identificadas"
    },
    "orientacoes_gerais": {
      "type": "string",
      "description": "Orienta\u00e7\u00f5es nutricionais gerais"
    },
    "alimentos_evitar": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de alimentos a evitar"
    },
    "alimentos_recomendados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de alimentos recomendados"
    },
    "suplementacao_necessaria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suplementos recomendados"
    },
    "horarios_alimentacao": {
      "type": "string",
      "description": "Orienta\u00e7\u00f5es sobre hor\u00e1rios das refei\u00e7\u00f5es em rela\u00e7\u00e3o aos medicamentos"
    },
    "observacoes_especiais": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es especiais para o paciente"
    },
    "data_geracao": {
      "type": "string",
      "format": "date",
      "description": "Data de gera\u00e7\u00e3o da orienta\u00e7\u00e3o"
    },
    "validade": {
      "type": "string",
      "format": "date",
      "description": "Validade da orienta\u00e7\u00e3o"
    }
  },
  "required": [
    "patient_id",
    "nome_paciente",
    "medicamentos_analisados"
  ]
}